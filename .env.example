# 复制为 .env 后按需覆盖；.env 不提交。
POSTGRES_DB=ragdb
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_pw
POSTGRES_PORT=5432

# Phase 4 governance API: X-Admin-Token for WorkItem approve/deny.
# Leave empty to start the service but reject all approvals with 401. Never commit a real value.
ADMIN_TOKEN=

# Phase 5 MCP: Authorization: Bearer <MCP_AUTH_TOKEN> for /mcp.
# Separate from ADMIN_TOKEN. Leave empty to start the service but reject all /mcp calls with 401.
MCP_AUTH_TOKEN=
